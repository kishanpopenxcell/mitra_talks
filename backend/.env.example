# ---------------------------------------------------------------------------
# Backend environment configuration for the Mood-Based AI Voice Companion.
# Copy this file to `.env` (same directory) and fill in real values.
# NEVER commit a `.env` file containing real secrets.
# ---------------------------------------------------------------------------

# --- Hugging Face Inference Providers -------------------------------------
# Create a token at https://huggingface.co/settings/tokens (read access is
# enough). Required for chat (LLM) and speech-to-text (STT).
HF_TOKEN=

# Chat/LLM model + provider (see README for why these were chosen).
# NOTE: must be a model that is NOT gated on the Hub (no license-acceptance
# click-through) -- LangChain's ChatHuggingFace resolves the model id against
# the Hub and a gated repo will fail with a 403 GatedRepoError even though
# the actual inference call goes to a remote provider. Qwen2.5-7B-Instruct is
# fully open (Apache-2.0).
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_LLM_PROVIDER=featherless-ai

# Speech-to-text model + provider.
HF_STT_MODEL=openai/whisper-large-v3
HF_STT_PROVIDER=hf-inference

# --- Text-to-Speech (Cartesia, primary) ------------------------------------
# Cartesia is used instead of Hugging Face for TTS because HF Inference
# Providers currently has no working TTS routing (see README + tts_service.py
# for details). Get a key at https://play.cartesia.ai/
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
# A Cartesia voice ID (see https://play.cartesia.ai/voices). Leave blank to
# use the default configured in the service.
CARTESIA_VOICE_ID=

# --- Optional fallback providers (swappable, not required to run the MVP) --
# Groq Whisper API - fallback STT if Hugging Face STT fails.
GROQ_API_KEY=
# Deepgram Aura-2 - fallback TTS if Cartesia fails/unavailable.
DEEPGRAM_API_KEY=

# --- CORS -------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# --- Conversation / performance controls ------------------------------------
# Maximum number of prior messages (user+assistant) kept and sent to the LLM.
# Oldest messages are trimmed first once this cap is exceeded.
MAX_CONVERSATION_MESSAGES=20

# Upper bound on generated tokens per LLM response (keeps latency/cost sane).
MAX_RESPONSE_TOKENS=300
